# Runtime directory for SQLite, uploaded evidence, annotated data and generated reports.
PYAaZSCAN_DATA_DIR=./data/runtime

# Optional: comma-separated explicit CORS origins if the frontend is hosted separately.
PYAaZSCAN_CORS_ORIGINS=

# Maximum accepted photo upload size (bytes). Default: 12 MiB.
PYAaZSCAN_MAX_UPLOAD_BYTES=12582912
